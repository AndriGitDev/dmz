{
  "name": "dmz-chromium-extension",
  "version": "0.1.3",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "build": "wxt build -b chrome",
    "check": "wxt prepare && tsc --noEmit",
    "zip": "wxt zip -b chrome",
    "record:build": "node scripts/record-build.mjs",
    "test:browser": "node scripts/browser-smoke.mjs && node scripts/chat-smoke.mjs && node scripts/chat-races.mjs && node scripts/composer-smoke.mjs",
    "build:scanner": "node scripts/build-scanner.mjs",
    "test:scanner": "node scripts/scanner-unit.mjs && node scripts/scanner-lifecycle-unit.mjs && node scripts/scanner-smoke.mjs",
    "test:coverage": "node scripts/coverage-unit.mjs && node scripts/typed-quality-unit.mjs",
    "build:alpha": "DMZ_RELEASE_LABEL=alpha.3 node scripts/build-scanner.mjs",
    "record:alpha": "DMZ_RELEASE_LABEL=alpha.3 node scripts/record-build.mjs",
    "build:test-release": "DMZ_RELEASE_LABEL=alpha.3 node scripts/build-test-release.mjs",
    "test:pause": "node scripts/pause-smoke.mjs"
  },
  "devDependencies": {
    "@types/chrome": "^0.1.34",
    "@types/node": "^22.20.4",
    "playwright": "^1.63.0",
    "typescript": "^5.9.0",
    "wxt": "^0.21.4"
  }
}
