  "adaptation": "Selected context-free rules; source-code trailing delimiter replaced with DMZ whole-token boundary checks.",
  "rules": [
    {
      "id": "digitalocean-access-token",
      "pattern": "\\b(doo_v1_[a-f0-9]{64})",
      "entropy": 3,
      "keywords": [
        "doo_v1_"
      ]
    },
    {
      "id": "digitalocean-pat",
      "pattern": "\\b(dop_v1_[a-f0-9]{64})",
      "entropy": 3,
      "keywords": [
        "dop_v1_"
      ]
    },
    {
      "id": "gitlab-pat",
      "pattern": "glpat-[\\w-]{20}",
      "entropy": 3,
      "keywords": [
        "glpat-"
      ]
    },
    {
      "id": "huggingface-access-token",
      "pattern": "\\b(hf_(?i:[a-z]{34}))",
      "entropy": 2,
      "keywords": [
        "hf_"
      ]
    },
    {
      "id": "huggingface-organization-api-token",
      "pattern": "\\b(api_org_(?i:[a-z]{34}))",
      "entropy": 2,
      "keywords": [
        "api_org_"
      ]
    },
    {
      "id": "linear-api-key",
      "pattern": "lin_api_(?i)[a-z0-9]{40}",
      "entropy": 2,
      "keywords": [
        "lin_api_"
      ]
    },
    {
      "id": "notion-api-token",
      "pattern": "\\b(ntn_[0-9]{11}[A-Za-z0-9]{32}[A-Za-z0-9]{3})",
      "entropy": 4,
      "keywords": [
        "ntn_"
      ]
    },
    {
      "id": "npm-access-token",
