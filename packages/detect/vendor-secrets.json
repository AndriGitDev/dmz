      "keywords": [
        "npm_"
      ]
    },
    {
      "id": "pypi-upload-token",
      "pattern": "pypi-AgEIcHlwaS5vcmc[\\w-]{50,1000}",
      "entropy": 3,
      "keywords": [
        "pypi-ageichlwas5vcmc"
      ]
    },
    {
      "id": "sendgrid-api-token",
      "pattern": "\\b(SG\\.(?i)[a-z0-9=_\\-\\.]{66})",
      "entropy": 2,
      "keywords": [
        "sg."
      ]
    },
    {
      "id": "shopify-access-token",
      "pattern": "shpat_[a-fA-F0-9]{32}",
      "entropy": 2,
      "keywords": [
        "shpat_"
      ]
    },
    {
      "id": "shopify-custom-access-token",
      "pattern": "shpca_[a-fA-F0-9]{32}",
      "entropy": 2,
      "keywords": [
        "shpca_"
      ]
    },
    {
      "id": "shopify-private-app-access-token",
      "pattern": "shppa_[a-fA-F0-9]{32}",
      "entropy": 2,
      "keywords": [
        "shppa_"
      ]
    },
    {
      "id": "shopify-shared-secret",
      "pattern": "shpss_[a-fA-F0-9]{32}",
      "entropy": 2,
      "keywords": [
        "shpss_"
      ]
    },
    {
      "id": "slack-bot-token",
      "pattern": "xoxb-[0-9]{10,13}-[0-9]{10,13}[a-zA-Z0-9-]*",
      "entropy": 3,
      "keywords": [
        "xoxb"
      ]
    },
    {
      "id": "stripe-access-token",
      "pattern": "\\b((?:sk|rk)_(?:test|live|prod)_[a-zA-Z0-9]{10,99})",
      "entropy": 2,
      "keywords": [
        "sk_test",
        "sk_live",
        "sk_prod",
        "rk_test",
        "rk_live",
        "rk_prod"
      ]
    },
    {
      "id": "twilio-api-key",
      "pattern": "SK[0-9a-fA-F]{32}",
      "entropy": 3,
      "keywords": [
        "sk"
      ]
    }
  ],
  "allow_regexes": [
    "(?i)^true|false|null$",
    "^(?i:a+|b+|c+|d+|e+|f+|g+|h+|i+|j+|k+|l+|m+|n+|o+|p+|q+|r+|s+|t+|u+|v+|w+|x+|y+|z+|\\*+|\\.+)$",
    "^\\$(?:\\d+|{\\d+})$",
    "^\\$(?:[A-Z_]+|[a-z_]+)$",
    "^\\${(?:[A-Z_]+|[a-z_]+)}$",
    "^\\{\\{[ \\t]*[\\w ().|]+[ \\t]*}}$",
    "^\\$\\{\\{[ \\t]*(?:(?:env|github|secrets|vars)(?:\\.[A-Za-z]\\w+)+[\\w \"'&./=|]*)[ \\t]*}}$",
    "^%(?:[A-Z_]+|[a-z_]+)%$",
    "^%[+\\-# 0]?[bcdeEfFgGoOpqstTUvxX]$",
    "^\\{\\d{0,2}}$",
    "^@(?:[A-Z_]+|[a-z_]+)@$",
    "^/Users/(?i)[a-z0-9]+/[\\w .-/]+$",
    "^/(?:bin|etc|home|opt|tmp|usr|var)/[\\w ./-]+$"
  ],
  "allow_stopwords": [
    "014df517-39d1-4453-b7b3-9930c563627c",
    "abcdefghijklmnopqrstuvwxyz"
  ]
}
